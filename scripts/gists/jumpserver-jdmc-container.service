# Managed by the JumpServer installer
[Unit]
Description=Restore JumpServer JDMC container and node mounts
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=USE_XPACK=1
ExecStart=/bin/bash /opt/current/installer/jmsctl.sh start jdmc
Restart=on-failure
RestartSec=15s
TimeoutStartSec=3min

[Install]
WantedBy=multi-user.target
